# Telegram Bot
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/globaledunova

# Application
NODE_ENV=development
LOG_LEVEL=info

# Optional: manager contact for "Contact Manager" feature
MANAGER_USERNAME=your_manager_username

# Comma-separated Telegram user IDs allowed to use /admin
ADMIN_TELEGRAM_IDS=123456789,987654321

# Optional: group chat ID for manager alerts (falls back to ADMIN_TELEGRAM_IDS)
MANAGER_CHAT_ID=

# Health check HTTP port
HEALTH_PORT=3000

# Rate limiting (per user, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
SESSION_TTL_MS=86400000

# Queue hardening
QUEUE_CONCURRENCY=5
QUEUE_CIRCUIT_BREAKER_FAILURES=10
QUEUE_STALLED_AFTER_MS=900000

# File storage (telegram | local | s3)
DEFAULT_STORAGE_PROVIDER=telegram
LOCAL_STORAGE_DIR=./uploads
UPLOAD_TIMEOUT_MS=30000

# S3 / MinIO (optional)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Database backups
BACKUP_DIR=./backups

# ---------------------------------------------------------------------------
# Platform integration (Faza 0 — institution applications)
# ---------------------------------------------------------------------------
# The real HTTP client is used only when BOTH of these are set; otherwise the bot
# runs on the in-process stub and logs an error in production, because a stub in
# production silently swallows real institutions' applications.
# Leave both empty until the platform is deployed and reachable from this host.
PLATFORM_URL=
PLATFORM_SERVICE_TOKEN=

# Timeout for a single platform request.
PLATFORM_TIMEOUT_MS=15000

# How often open applications are re-checked. The pipeline stages are performed by
# humans in a web panel, so minutes are plenty. Minimum accepted: 30000.
PLATFORM_POLL_INTERVAL_MS=300000

# Applications stop being polled after this long without reaching a terminal stage
# (default 60 days). They are neither deleted nor hidden from the applicant.
PLATFORM_POLL_MAX_AGE_MS=5184000000

# The bot's own JSON data files (submitted application records).
DATA_DIR=./data

# NOTE for Faza 0: charters must be stored as real files, so set
#   DEFAULT_STORAGE_PROVIDER=local
# above. With the default `telegram` provider only a file_id is kept and the
# platform cannot be handed a storageRef it can read.
