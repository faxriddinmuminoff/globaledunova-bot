# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# NOTE: the previous version of this file had the token line written as a bare
# `YOUR_BOT_TOKEN_HERE` with no `BOT_TOKEN=` prefix, so copying it produced a
# config that failed Zod validation on the very first boot.
BOT_TOKEN=your_bot_token_here

# ---------------------------------------------------------------------------
# Platform integration (Faza 0 — institution applications)
# ---------------------------------------------------------------------------
# The HTTP client is used only when BOTH of these are set; otherwise the bot runs
# on the in-process stub and logs an error in production, because a stub in
# production silently swallows real institutions' applications.
# Leave both empty until the platform is deployed and reachable from this host.
PLATFORM_URL=
PLATFORM_SERVICE_TOKEN=

# Request timeout for platform calls.
PLATFORM_TIMEOUT_MS=15000
# How often open applications are re-checked. The pipeline stages are performed by
# humans in a web panel, so minutes are plenty. Minimum accepted: 30000.
PLATFORM_POLL_INTERVAL_MS=300000
# Applications stop being polled after this long without reaching a terminal stage
# (default 60 days). They are neither deleted nor hidden from the applicant.
PLATFORM_POLL_MAX_AGE_MS=5184000000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# The bot's own JSON data files (application records).
DATA_DIR=./data
# Charters are written to LOCAL_STORAGE_DIR/org-apps/, named after their sha256.
DEFAULT_STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# PostgreSQL. Still required in production by the parts of the bot that have not
# been ported off it yet (users, notifications, queue, audit, settings).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/globaledunova

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Telegram ids allowed to use /admin, comma separated.
ADMIN_TELEGRAM_IDS=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
